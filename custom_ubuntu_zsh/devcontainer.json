{
  "name": "ubuntu-zsh",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "FZF_VERSION": "latest",
      "TEALDEER_VERSION": "latest"
    }
  },
  "remoteUser": "ubuntu",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh"
      }
    }
  }
}
